.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# DVC related files
# Ignore the DVC cache directory
.dvc/cache
# Ignore the actual data/model files managed by DVC.
# Git only needs to track the corresponding .dvc files.
/data/imdb.csv
/models/model.pkl
/models/vectorizer.pkl

# Logs
*.log
logs/
*.log.*

# Instance folder (e.g., for Flask secrets)
/instance

# Temporary files
*~
# End ignored files
